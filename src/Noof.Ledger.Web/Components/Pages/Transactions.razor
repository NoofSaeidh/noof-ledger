@page "/transactions"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using Microsoft.AspNetCore.Components.QuickGrid
@using Noof.Ledger.Application.Categorization
@using Noof.Ledger.Application.Diagnostics
@using Noof.Ledger.Application.Reporting
@using Noof.Ledger.Application.Wallets
@using Noof.Ledger.Domain
@inject ITransactionList TransactionList
@inject IWalletDirectory WalletDirectory
@inject IDatabaseGate Gate

<PageTitle>Transactions</PageTitle>

<MudText HtmlTag="h1" Typo="Typo.h4" Class="mb-4">Transactions</MudText>

@if (Gate.State != DatabaseState.Ready)
{
    <DatabaseGateBanner />
}
else
{
    <MudGrid id="transactions-filters" Spacing="2" Class="mb-4">
        <MudItem xs="12">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mr-2" OnClick="@(() => SetQuickRangeAsync(QuickRange.Today))">Today</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mr-2" OnClick="@(() => SetQuickRangeAsync(QuickRange.Last7Days))">7 days</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mr-2" OnClick="@(() => SetQuickRangeAsync(QuickRange.ThisMonth))">This month</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SetQuickRangeAsync(QuickRange.All))">All</MudButton>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">From</MudText>
            <input type="date" id="transactions-filter-from" class="noof-input" @bind="filter.From" @bind:event="oninput" @bind:after="ReloadAsync" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">To</MudText>
            <input type="date" id="transactions-filter-to" class="noof-input" @bind="filter.To" @bind:event="oninput" @bind:after="ReloadAsync" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Wallet</MudText>
            <select id="transactions-filter-wallet" @bind="filter.WalletId" @bind:after="ReloadAsync" class="noof-native-select">
                <option value="">All wallets</option>
                @foreach (var wallet in wallets)
                {
                    <option value="@wallet.Id">@wallet.Name</option>
                }
            </select>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Kind</MudText>
            <select id="transactions-filter-kind" @bind="filter.Kind" @bind:after="ReloadAsync" class="noof-native-select">
                <option value="">All kinds</option>
                @foreach (var kind in Enum.GetValues<TransactionKind>())
                {
                    <option value="@kind">@kind</option>
                }
            </select>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Status</MudText>
            <select id="transactions-filter-status" @bind="filter.Status" @bind:after="ReloadAsync" class="noof-native-select">
                <option value="">All statuses</option>
                @foreach (var status in Enum.GetValues<TransactionStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Text</MudText>
            <input id="transactions-filter-text" class="noof-input" @bind="filter.Text" @bind:event="oninput" @bind:after="ReloadAsync" />
        </MudItem>
    </MudGrid>

    <QuickGrid @key="reloadGeneration" TGridItem="TransactionListRow" id="transactions-grid" ItemsProvider="ProvideRowsAsync" Pagination="pagination" Class="mb-2">
        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="TransactionListRow" Title="Date" Context="row">
            <MudLink Href="@($"/transactions/{row.Id}/trace")">@FormatOccurred(row)</MudLink>
        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
        <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn TGridItem="TransactionListRow" TProp="string" Property="@(row => row.WalletName)" Title="Wallet" />
        <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn TGridItem="TransactionListRow" TProp="TransactionKind" Property="@(row => row.Kind)" Title="Kind" />
        <Microsoft.AspNetCore.Components.QuickGrid.PropertyColumn TGridItem="TransactionListRow" TProp="TransactionStatus" Property="@(row => row.Status)" Title="Status" />
        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="TransactionListRow" Title="Text" Context="row">
            <span class="noof-truncate" style="display:inline-block;">@row.RawText</span>
        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="TransactionListRow" Title="Amounts" Context="row">
            @FormatAmounts(row.Amounts)
        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn TGridItem="TransactionListRow" Title="Categories" Context="row">
            @string.Join(", ", row.Categories)
        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
    </QuickGrid>
    <Paginator State="pagination" />
}

@code {
    enum QuickRange { Today, Last7Days, ThisMonth, All }

    sealed class TransactionFilterEdit
    {
        public DateOnly? From { get; set; }
        public DateOnly? To { get; set; }
        public Guid? WalletId { get; set; }
        public TransactionKind? Kind { get; set; }
        public TransactionStatus? Status { get; set; }
        public string? Text { get; set; }
    }

    readonly TransactionFilterEdit filter = new();
    readonly PaginationState pagination = new() { ItemsPerPage = 50 };
    int reloadGeneration;
    IReadOnlyList<WalletOption> wallets = [];

    protected override async Task OnInitializedAsync()
    {
        if (Gate.State == DatabaseState.Ready)
            wallets = await WalletDirectory.ActiveAsync(CancellationToken.None);
    }

    async ValueTask<GridItemsProviderResult<TransactionListRow>> ProvideRowsAsync(GridItemsProviderRequest<TransactionListRow> request)
    {
        var page = await TransactionList.QueryAsync(
            ToFilter(), request.StartIndex / pagination.ItemsPerPage, pagination.ItemsPerPage, request.CancellationToken);
        return GridItemsProviderResult.From([.. page.Rows], page.TotalCount);
    }

    TransactionListFilter ToFilter() => new(filter.From, filter.To, filter.WalletId, filter.Kind, filter.Status, filter.Text);

    Task SetQuickRangeAsync(QuickRange range)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        (filter.From, filter.To) = range switch
        {
            QuickRange.Today => (today, today),
            QuickRange.Last7Days => (today.AddDays(-6), today),
            QuickRange.ThisMonth => (new DateOnly(today.Year, today.Month, 1), today),
            _ => ((DateOnly?)null, (DateOnly?)null),
        };
        return ReloadAsync();
    }

    Task ReloadAsync()
    {
        // Same reasoning as DiagnosticsLogs.razor: incrementing @key tears down the old QuickGrid
        // instance instead of asking it to refresh in place, so a filter change never races the
        // grid's own still in-flight load.
        reloadGeneration++;
        return pagination.SetCurrentPageIndexAsync(0);
    }

    static string FormatOccurred(TransactionListRow row)
    {
        var day = row.OccurredOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        return row.OccurredAt is { } time ? $"{day} {time.ToString("HH:mm", CultureInfo.InvariantCulture)}" : day;
    }

    static string FormatAmounts(IReadOnlyList<Money> amounts) =>
        amounts.Count == 0 ? "—" : string.Join(", ", amounts.Select(FormatMoney));

    static string FormatMoney(Money money) => $"{money.Amount.ToString("N2", CultureInfo.InvariantCulture)} {money.Currency}";
}

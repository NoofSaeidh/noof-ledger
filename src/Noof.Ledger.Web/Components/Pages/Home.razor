@page "/"
@attribute [Authorize]
@implements IDisposable
@using System.Data.Common
@using System.Globalization
@using Noof.Ledger.Application.Diagnostics
@using Noof.Ledger.Application.Reporting
@using Noof.Ledger.Domain
@inject ISpendingReadModel ReadModel
@inject IBalanceReadModel BalanceReadModel
@inject ISystemHealth SystemHealth
@inject IDatabaseGate DatabaseGate

<PageTitle>Ledger</PageTitle>

@* HtmlTag="h1" rather than Typo.h1: the document needs exactly one h1 for FocusOnNavigate and for
   the smoke test, but Typo.h1 is display-sized type that would dwarf everything under it. *@
<MudText HtmlTag="h1" Typo="Typo.h4" Class="mb-1">Ledger</MudText>

@if (DatabaseGate.State != DatabaseState.Ready)
{
    <DatabaseGateBanner />
}
else
{
    <MudAlert id="health-tile" Severity="@HealthSeverity(health?.Overall)" Variant="Variant.Outlined" Class="mt-6 mb-6">
        @if (health is null)
        {
            <MudText Typo="Typo.body2">Checking system health…</MudText>
        }
        else if (health.Items.All(item => item.Level == HealthLevel.Ok))
        {
            <MudText Typo="Typo.body2">All systems normal.</MudText>
        }
        else
        {
            @foreach (var item in health.Items.Where(item => item.Level != HealthLevel.Ok))
            {
                <MudText Typo="Typo.body2">@item.Name — @item.Summary</MudText>
            }
        }
        <MudLink Href="/diagnostics" Underline="Underline.Always" Class="mt-1" Style="display:inline-block;">Diagnostics &rarr;</MudLink>
    </MudAlert>

    @if (databaseUnavailable)
    {
        @* Distinct from "no spending yet" below: that means the database answered and there is
           nothing in it, this means the database never answered at all. PostgreSQL on this machine
           is Manual-start and sometimes simply isn't running, so this is an expected front-page
           state, not a crash - conflating the two would say "you have no spending" when the truth
           is "we don't know". The health tile above still reflects its own check, which reads the
           database independently of this page's own read-model queries. *@
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
            The health tile above still reflects the database's own check - the sections below are
            unavailable because a request made while loading this page failed.
        </MudText>
    }
    else
    {
    <MudPaper id="balances" Outlined="true" Elevation="0" Class="pa-5 mb-8">
        <MudText HtmlTag="h2" Typo="Typo.h6" Class="mb-3">Balances</MudText>

        @if (activeBalances.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No active wallets yet.</MudText>
        }
        else
        {
            @foreach (var wallet in activeBalances)
            {
                <div id="@($"balance-{wallet.WalletId}")" class="noof-balance-row mb-2">
                    <MudText Typo="Typo.body1">@wallet.WalletName</MudText>
                    <MudText Typo="Typo.body1" Class="noof-amount">@FormatBalances(wallet.Balances)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @(wallet.LastCheckedOn is { } checkedOn
                            ? $"Reconciled {checkedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}"
                            : "Not yet reconciled")
                    </MudText>
                </div>
            }

            @if (currencyTotals.Count > 0)
            {
                <MudDivider Class="my-3" />

                @foreach (var total in currencyTotals)
                {
                    <div id="@($"balance-total-{total.Currency}")" class="noof-balance-total">
                        <MudText Typo="Typo.subtitle2">Total @total.Currency</MudText>
                        <MudText Typo="Typo.subtitle2" Class="noof-amount">@FormatAmount(total.Amount) @total.Currency</MudText>
                    </div>
                }
            }
        }
    </MudPaper>

    <div id="this-month">
        <div class="noof-txn-header mb-3">
            <MudText HtmlTag="h2" Typo="Typo.h6">This month</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                from @summaryFirstDay.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
            </MudText>
        </div>

        @if (currencyGroups.Count == 0)
        {
            <MudPaper Outlined="true" Elevation="0" Class="pa-8 mb-8">
                <MudText Typo="Typo.body1" Align="Align.Center" Class="mud-text-secondary">
                    No spending or income recorded this month.
                </MudText>
            </MudPaper>
        }
        else
        {
            <MudGrid Spacing="4" Class="mb-4 noof-month-grid">
                @foreach (var group in currencyGroups)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Outlined="true" Elevation="0" Class="pa-5">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">@group.Currency this month</MudText>

                            @if (group.Totals.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">Spent</MudText>
                                <MudText Typo="Typo.h4" Class="noof-amount">@FormatAmount(group.Total)</MudText>

                                @* One category is not a distribution, so a ring of a single slice would be a
                                   decoration that says nothing. The table below is the real answer either
                                   way; the chart only earns its space once there is a shape to see. *@
                                @if (group.Totals.Count > 1)
                                {
                                    <div class="noof-chart">
                                        <MudChart T="double"
                                                  ChartType="ChartType.Donut"
                                                  ChartSeries="@group.Series"
                                                  ChartLabels="@group.Labels"
                                                  LegendPosition="Position.Right"
                                                  ChartOptions="@DonutOptions"
                                                  Height="220px" />
                                    </div>
                                }

                                <MudSimpleTable id="@($"month-totals-{group.Currency}")" Dense="true" Hover="true"
                                                Elevation="0" Class="noof-totals-table mt-2">
                                    <tbody>
                                        @foreach (var total in group.Totals)
                                        {
                                            <tr>
                                                <td>@total.CategoryName</td>
                                                <td class="noof-amount noof-numeric">@FormatAmount(total.Amount)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }

                            @if (group.Received.Count > 0)
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-4">Received</MudText>
                                <MudText Typo="Typo.h6" Class="noof-amount">@FormatAmount(group.ReceivedTotal)</MudText>
                                <MudSimpleTable id="@($"month-received-{group.Currency}")" Dense="true" Hover="true"
                                                Elevation="0" Class="noof-totals-table mt-2">
                                    <tbody>
                                        @foreach (var total in group.Received)
                                        {
                                            <tr>
                                                <td>@total.CategoryName</td>
                                                <td class="noof-amount noof-numeric">@FormatAmount(total.Amount)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </div>

    @* No donut: an amount moved between the operator's own wallets says nothing about spending (T-9). *@
    <div class="noof-txn-header mt-8 mb-3">
        <MudText HtmlTag="h2" Typo="Typo.h6">Transfers this month</MudText>
    </div>

    <MudPaper id="month-transfers" Outlined="true" Elevation="0" Class="pa-5 mb-4">
        @if (monthTransfers.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No transfers this month.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0" Class="noof-totals-table">
                <tbody>
                    @foreach (var transfer in monthTransfers)
                    {
                        <tr id="@($"month-transfer-{transfer.Id}")">
                            <td class="mud-text-secondary">@transfer.OccurredOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                            <td>
                                <MudLink Href="@($"/transactions/{transfer.Id}/trace")">@LedgerText.TransferWithRate(transfer.Transfer)</MudLink>
                                @if (LedgerText.TransferFee(transfer.Transfer) is { } fee)
                                {
                                    <div class="mud-text-secondary">@fee</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            @if (transferFees.Count > 0)
            {
                <MudText id="month-transfer-fees" Typo="Typo.body2" Class="mt-3">
                    Fees: @string.Join(", ", transferFees.Select(FormatMoney))
                </MudText>
            }
        }
    </MudPaper>

    <div class="noof-txn-header mt-8 mb-3">
        <MudText HtmlTag="h2" Typo="Typo.h6">Recent transactions</MudText>
        <MudSpacer />
        <MudLink Href="/transactions">All transactions</MudLink>
    </div>

    @* Links rather than tabs or a menu: this page renders statically, so the view lives in the URL (spec §4). *@
    <div id="recent-views" class="d-flex gap-4 mb-3">
        @foreach (var (view, query, label) in RecentViews)
        {
            <MudLink id="@($"recent-view-{query}")" Href="@($"/?view={query}")"
                     Color="@(view == recentView ? Color.Primary : Color.Default)"
                     Underline="@(view == recentView ? Underline.Always : Underline.Hover)"
                     aria-current="@(view == recentView ? "page" : null)">@label</MudLink>
        }
    </div>

    @if (recent.Count == 0)
    {
        <MudPaper Outlined="true" Elevation="0" Class="pa-8">
            <MudText Typo="Typo.body1" Align="Align.Center" Class="mud-text-secondary">
                @(recentView == RecentView.Transfers ? "No transfers yet." : "Nothing captured yet.")
            </MudText>
        </MudPaper>
    }
    else
    {
        @foreach (var transaction in recent)
        {
            <MudPaper id="@($"txn-{transaction.Id}")" Outlined="true" Elevation="0" Class="pa-4 mb-3">
                <div class="noof-txn-header">
                    <MudText Typo="Typo.body2">@transaction.WalletName</MudText>
                    <MudLink Href="@($"/transactions/{transaction.Id}/trace")">
                        <MudText Typo="Typo.caption">@FormatOccurred(transaction)</MudText>
                    </MudLink>
                    <MudSpacer />
                    @* Only a record that has been read has a known kind; until then it is stored as the default. *@
                    @if (transaction.Status == TransactionStatus.Completed)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@DescribeKind(transaction.Kind)</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@StatusColour(transaction.Status)">
                        @DescribeStatus(transaction.Status)
                    </MudChip>
                </div>

                <MudText Typo="Typo.body1" Class="mt-2">@transaction.RawText</MudText>

                @if (transaction.Status == TransactionStatus.Captured)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Awaiting categorisation - this message has not been read by the categoriser yet.
                    </MudText>
                }
                else if (transaction.Status == TransactionStatus.Failed)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">
                        Categorisation failed. Nothing was recorded for this message.
                    </MudText>
                }
                else if (transaction.Transfer is { } transfer)
                {
                    <MudText Typo="Typo.body2" Class="mt-2 noof-amount">@LedgerText.TransferWithRate(transfer)</MudText>
                    @if (LedgerText.TransferFee(transfer) is { } fee)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@fee</MudText>
                    }
                }
                else if (transaction.Kind == TransactionKind.BalanceCheck)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        A balance statement - it sets what the wallet holds and is not spending.
                    </MudText>
                }
                else if (transaction.Items.Count == 0)
                {
                    @* A Completed transaction with no line items is a real, positive read of the
                       message - the categoriser looked at it and found nothing to record (a loan
                       received, not a purchase, for example) - not a failure, and not a blank row
                       that looks broken. *@
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Read - nothing here looked like spending, so nothing was recorded.
                    </MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0" Class="mt-2 noof-items-table">
                        <tbody>
                            @foreach (var item in transaction.Items)
                            {
                                <tr>
                                    <td class="noof-item-category">@(item.CategoryName ?? "Uncategorised")</td>
                                    <td>
                                        @item.Description
                                        @if (item.MerchantName is not null)
                                        {
                                            <span class="mud-text-secondary">&nbsp;&middot; @item.MerchantName</span>
                                        }
                                        @if (item.Role == EntryRole.Fee)
                                        {
                                            <span class="mud-text-secondary">&nbsp;&middot; fee</span>
                                        }
                                    </td>
                                    <td class="noof-amount noof-numeric">@FormatMoney(item.Amount)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        }
    }
    }
}

@code {
    static readonly DonutChartOptions DonutOptions = new() { ChartPalette = NoofTheme.ChartPalette };

    static readonly (RecentView View, string Query, string Label)[] RecentViews =
    [
        (RecentView.SpendingAndIncome, "spending", "Spending & income"),
        (RecentView.Transfers, "transfers", "Transfers"),
        (RecentView.All, "all", "All"),
    ];

    // SupplyParameterFromQuery does not bind enums, hence the string (DiagnosticsLogs does the same).
    [SupplyParameterFromQuery]
    public string? View { get; set; }

    RecentView recentView;

    IReadOnlyList<RecentTransaction> recent = [];
    IReadOnlyList<CurrencyGroup> currencyGroups = [];
    IReadOnlyList<MonthTransfer> monthTransfers = [];
    IReadOnlyList<Money> transferFees = [];
    IReadOnlyList<WalletBalance> activeBalances = [];
    IReadOnlyList<CurrencyTotal> currencyTotals = [];
    SystemHealthReport? health;
    DateOnly summaryFirstDay;
    bool databaseUnavailable;

    readonly CancellationTokenSource cancellation = new();

    sealed record CurrencyTotal(string Currency, decimal Amount);

    sealed record CurrencyGroup(string Currency, IReadOnlyList<MonthTotal> Totals, IReadOnlyList<MonthTotal> Received)
    {
        public decimal Total => Totals.Sum(total => total.Amount);

        public decimal ReceivedTotal => Received.Sum(total => total.Amount);

        public List<ChartSeries<double>> Series =>
            [new() { Name = Currency, Data = new ChartData<double>([.. Totals.Select(total => (double)total.Amount)]) }];

        public string[] Labels => [.. Totals.Select(total => total.CategoryName)];
    }

    protected override async Task OnParametersSetAsync()
    {
        recentView = ParseView(View);

        if (DatabaseGate.State != DatabaseState.Ready)
            return;

        try
        {
            recent = await ReadModel.RecentAsync(20, recentView, cancellation.Token);

            var summary = await ReadModel.ThisMonthAsync(cancellation.Token);
            summaryFirstDay = summary.FirstDay;
            currencyGroups = GroupByCurrency(summary.Totals, summary.Received ?? []);

            monthTransfers = await ReadModel.TransfersThisMonthAsync(cancellation.Token);
            transferFees =
            [
                .. monthTransfers
                    .Select(transfer => transfer.Transfer.Fee)
                    .Where(LedgerText.IsFee)
                    .OfType<Money>()
                    .GroupBy(fee => fee.Currency.Value)
                    .OrderBy(group => group.Key, StringComparer.Ordinal)
                    .Select(group => new Money(group.Sum(fee => fee.Amount), group.First().Currency)),
            ];

            var allBalances = await BalanceReadModel.BalancesAsync(cancellation.Token);
            activeBalances =
            [
                .. allBalances
                    .Where(wallet => !wallet.Archived)
                    .OrderBy(wallet => wallet.WalletName, StringComparer.Ordinal),
            ];
            currencyTotals =
            [
                .. activeBalances
                    .SelectMany(wallet => wallet.Balances)
                    .GroupBy(money => money.Currency.Value)
                    .OrderBy(group => group.Key, StringComparer.Ordinal)
                    .Select(group => new CurrencyTotal(group.Key, group.Sum(money => money.Amount))),
            ];

            health = await SystemHealth.GetAsync(fresh: false, cancellation.Token);
        }
        // Navigating away before the query returns cancels it via our own token, not a database
        // failure - it must not land in the databaseUnavailable branch below, or leaving the page
        // mid-load would flash "can't reach the database" at whoever navigates here next.
        catch (OperationCanceledException)
        {
        }
        // Npgsql's own execution strategy (NpgsqlExecutionStrategy.ExecuteAsync) decides a connection
        // failure is "likely transient" and re-throws it wrapped in a plain InvalidOperationException
        // - with retry-on-failure never configured. So the type that actually crosses this await is
        // the wrapper, not the DbException underneath it, and that is true against a real PostgreSQL
        // that is briefly down, not just against a fake connection in a test. Matching on
        // InvalidOperationException + a specific InnerException shape is one EF/Npgsql version away
        // from silently not matching again, and the failure mode when it stops matching is a 500 on
        // the front page - exactly what this exists to prevent. Walking the whole InnerException
        // chain for a genuine DbException survives whatever EF wraps it in from here on, while still
        // refusing to swallow an ordinary bug in this page (no DbException anywhere in the chain).
        catch (Exception exception) when (IsDatabaseUnavailable(exception))
        {
            databaseUnavailable = true;
        }
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }

    static IReadOnlyList<CurrencyGroup> GroupByCurrency(IReadOnlyList<MonthTotal> spent, IReadOnlyList<MonthTotal> received) =>
    [
        .. spent.Concat(received)
            .Select(total => total.Currency.Value)
            .Distinct()
            .Order(StringComparer.Ordinal)
            .Select(currency => new CurrencyGroup(currency, InCurrency(spent, currency), InCurrency(received, currency))),
    ];

    static IReadOnlyList<MonthTotal> InCurrency(IReadOnlyList<MonthTotal> totals, string currency) =>
    [
        .. totals
            .Where(total => total.Currency.Value == currency)
            .OrderByDescending(total => total.Amount)
            .ThenBy(total => total.CategoryName, StringComparer.Ordinal),
    ];

    static bool IsDatabaseUnavailable(Exception exception) =>
        exception is DbException
        || (exception.InnerException is { } inner && IsDatabaseUnavailable(inner));

    static string FormatAmount(decimal amount) => amount.ToString("N2", CultureInfo.InvariantCulture);

    static string FormatMoney(Money money) => $"{FormatAmount(money.Amount)} {money.Currency}";

    static string FormatBalances(IReadOnlyList<Money> balances) =>
        balances.Count == 0 ? "—" : string.Join(", ", balances.Select(FormatMoney));

    static Severity HealthSeverity(HealthLevel? level) => level switch
    {
        HealthLevel.Ok => Severity.Success,
        HealthLevel.Warning => Severity.Warning,
        HealthLevel.Failing => Severity.Error,
        _ => Severity.Normal,
    };

    static string FormatOccurred(RecentTransaction transaction)
    {
        var day = transaction.OccurredOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        return transaction.LocalTime is { } time
            ? $"{day} {time.ToString("HH:mm", CultureInfo.InvariantCulture)}"
            : day;
    }

    static RecentView ParseView(string? view) => view?.ToLowerInvariant() switch
    {
        "transfers" => RecentView.Transfers,
        "all" => RecentView.All,
        _ => RecentView.SpendingAndIncome,
    };

    static string DescribeKind(TransactionKind kind) => kind switch
    {
        TransactionKind.Expense => "Spending",
        TransactionKind.Income => "Income",
        TransactionKind.BalanceCheck => "Balance statement",
        TransactionKind.Transfer => "Transfer",
        _ => kind.ToString(),
    };

    static string DescribeStatus(TransactionStatus status) => status switch
    {
        TransactionStatus.Captured => "Awaiting categorisation",
        TransactionStatus.Completed => "Categorised",
        TransactionStatus.Failed => "Categorisation failed",
        _ => "Unknown",
    };

    static Color StatusColour(TransactionStatus status) => status switch
    {
        TransactionStatus.Captured => Color.Warning,
        TransactionStatus.Completed => Color.Success,
        TransactionStatus.Failed => Color.Error,
        _ => Color.Default,
    };
}

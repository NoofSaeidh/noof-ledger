@page "/wallets"
@attribute [Authorize]
@implements IDisposable
@using System.Globalization
@using Noof.Ledger.Application.Diagnostics
@using Noof.Ledger.Application.Wallets
@using Noof.Ledger.Domain
@inject IWalletAdmin WalletAdmin
@inject IWalletFxTerms WalletFxTerms
@inject IDatabaseGate Gate
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Wallets</PageTitle>

<MudText HtmlTag="h1" Typo="Typo.h4" Class="mb-2">Wallets</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
    Create, rename and archive wallets, and set what spending in another currency costs each one. Income and balance
    statements are told to the bot.
</MudText>

@if (Gate.State != DatabaseState.Ready)
{
    <DatabaseGateBanner />
}
else
{

@if (error is not null)
{
    <MudAlert id="wallets-error" Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">@error</MudAlert>
}
@if (saved is not null)
{
    <MudAlert id="wallets-saved" Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">@saved</MudAlert>
}
@if (missingDefaultCurrencies.Count > 0)
{
    <MudAlert id="wallets-warning" Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
        @foreach (var currency in missingDefaultCurrencies)
        {
            <div>No default wallet for @currency — messages that name no wallet cannot be recorded until one is made default.</div>
        }
    </MudAlert>
}

@foreach (var wallet in wallets)
{
    <MudPaper id="@($"wallet-{wallet.Id}")" Outlined="true" Elevation="0" Class="pa-5 mb-4">
        <MudText Typo="Typo.overline" Class="mud-text-secondary d-block mb-2">@wallet.Currency</MudText>
        <div class="noof-wallet-row">
            <MudTextField T="string" InputId="@($"wallet-name-{wallet.Id}")" @bind-Value="wallet.PendingName"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Label="Name" />
            <MudButton id="@($"rename-{wallet.Id}")" Variant="Variant.Outlined"
                       OnClick="@(() => RenameAsync(wallet))">
                Rename
            </MudButton>
        </div>
        <div class="noof-wallet-row mt-4">
            <MudTextField T="string" InputId="@($"wallet-aliases-{wallet.Id}")" @bind-Value="wallet.PendingAliases"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Label="Aliases (comma-separated)" />
            <MudButton id="@($"save-aliases-{wallet.Id}")" Variant="Variant.Outlined"
                       OnClick="@(() => SaveAliasesAsync(wallet))">
                Save aliases
            </MudButton>
        </div>
        @if (!wallet.Archived)
        {
            <div class="noof-wallet-row mt-4">
                <MudText HtmlTag="label" for="@($"wallet-payment-default-{wallet.Id}")" Typo="Typo.caption" Class="mud-text-secondary">Default for</MudText>
                <select id="@($"wallet-payment-default-{wallet.Id}")" @bind="wallet.PendingPaymentDefault"
                        @bind:after="@(() => SetPaymentDefaultAsync(wallet))" class="noof-native-select">
                    <option value="">None</option>
                    <option value="@PaymentMethod.Card">Card</option>
                    <option value="@PaymentMethod.Cash">Cash</option>
                </select>
            </div>
        }
        <div class="noof-wallet-actions mt-4">
            @if (wallet.IsDefaultForCurrency)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    Default for @wallet.Currency
                </MudChip>
            }
            else
            {
                <MudButton id="@($"make-default-{wallet.Id}")" Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(() => MakeDefaultAsync(wallet))">
                    Make default for @wallet.Currency
                </MudButton>
            }

            @if (wallet.Archived)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Archived</MudChip>
            }
            else
            {
                <MudButton id="@($"archive-{wallet.Id}")" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => ArchiveAsync(wallet))">
                    Archive
                </MudButton>
            }
        </div>
        @if (!wallet.Archived)
        {
            @* Keyed by the row model, which every reload rebuilds with fresh converters: the fields are rebuilt with it,
               so a refused figure's error cannot outlive the converter that raised it. *@
            <div id="@($"terms-{wallet.Id}")" class="mt-6" @key="wallet">
                <MudText HtmlTag="h3" Typo="Typo.subtitle2">Foreign-currency terms</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                    What a spending in another currency costs this wallet: @wallet.Currency per one unit, plus a fee as a
                    percentage, a fixed amount, a minimum, or any mix. A currency with no terms stays in its own currency.
                </MudText>

                @foreach (var terms in wallet.Terms)
                {
                    <div id="@($"terms-row-{wallet.Id}-{terms.Currency}")" class="noof-form-grid noof-terms-grid">
                        <div class="noof-field">
                            <span class="noof-field-label">Currency</span>
                            <MudText Typo="Typo.body1">@terms.Currency</MudText>
                        </div>
                        <div class="noof-field">
                            <label class="noof-field-label" for="@($"terms-rate-{wallet.Id}-{terms.Currency}")">@wallet.Currency per 1 @terms.Currency</label>
                            <MudNumericField T="decimal?" InputId="@($"terms-rate-{wallet.Id}-{terms.Currency}")" @bind-Value="terms.Rate"
                                             Converter="@terms.RateConverter"
                                             Culture="@CultureInfo.InvariantCulture" Format="0.############" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <div class="noof-field">
                            <label class="noof-field-label" for="@($"terms-fee-percent-{wallet.Id}-{terms.Currency}")">Fee %</label>
                            <MudNumericField T="decimal?" InputId="@($"terms-fee-percent-{wallet.Id}-{terms.Currency}")" @bind-Value="terms.FeePercent"
                                             Converter="@terms.FeePercentConverter"
                                             Culture="@CultureInfo.InvariantCulture" Format="0.####" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <div class="noof-field">
                            <label class="noof-field-label" for="@($"terms-fee-fixed-{wallet.Id}-{terms.Currency}")">Fixed fee, @wallet.Currency</label>
                            <MudNumericField T="decimal?" InputId="@($"terms-fee-fixed-{wallet.Id}-{terms.Currency}")" @bind-Value="terms.FeeFixed"
                                             Converter="@terms.FeeFixedConverter"
                                             Culture="@CultureInfo.InvariantCulture" Format="0.00##" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <div class="noof-field">
                            <label class="noof-field-label" for="@($"terms-fee-minimum-{wallet.Id}-{terms.Currency}")">Minimum fee, @wallet.Currency</label>
                            <MudNumericField T="decimal?" InputId="@($"terms-fee-minimum-{wallet.Id}-{terms.Currency}")" @bind-Value="terms.FeeMinimum"
                                             Converter="@terms.FeeMinimumConverter"
                                             Culture="@CultureInfo.InvariantCulture" Format="0.00##" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <div class="noof-wallet-actions">
                            <MudButton id="@($"terms-save-{wallet.Id}-{terms.Currency}")" Variant="Variant.Outlined" Size="Size.Small"
                                       OnClick="@(() => SaveTermsAsync(wallet, terms))">
                                Save
                            </MudButton>
                            <MudButton id="@($"terms-remove-{wallet.Id}-{terms.Currency}")" Variant="Variant.Outlined" Size="Size.Small"
                                       Color="Color.Error" OnClick="@(() => RemoveTermsAsync(wallet, terms))">
                                Remove
                            </MudButton>
                        </div>
                    </div>
                }

                @if (wallet.OfferedCurrencies.Count > 0)
                {
                    <div class="noof-form-grid noof-terms-grid">
                        <div class="noof-field">
                            <label class="noof-field-label" for="@($"terms-new-currency-{wallet.Id}")">Currency</label>
                            <select id="@($"terms-new-currency-{wallet.Id}")" @bind="wallet.NewTerms.Currency" class="noof-native-select">
                                @foreach (var currency in wallet.OfferedCurrencies)
                                {
                                    <option value="@currency.Value">@currency.Value</option>
                                }
                            </select>
                        </div>
                        <div class="noof-field">
                            <label class="noof-field-label" for="@($"terms-new-rate-{wallet.Id}")">@wallet.Currency per unit</label>
                            <MudNumericField T="decimal?" InputId="@($"terms-new-rate-{wallet.Id}")" @bind-Value="wallet.NewTerms.Rate"
                                             Converter="@wallet.NewTerms.RateConverter"
                                             Culture="@CultureInfo.InvariantCulture" Format="0.############" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <div class="noof-field">
                            <label class="noof-field-label" for="@($"terms-new-fee-percent-{wallet.Id}")">Fee %</label>
                            <MudNumericField T="decimal?" InputId="@($"terms-new-fee-percent-{wallet.Id}")" @bind-Value="wallet.NewTerms.FeePercent"
                                             Converter="@wallet.NewTerms.FeePercentConverter"
                                             Culture="@CultureInfo.InvariantCulture" Format="0.####" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <div class="noof-field">
                            <label class="noof-field-label" for="@($"terms-new-fee-fixed-{wallet.Id}")">Fixed fee, @wallet.Currency</label>
                            <MudNumericField T="decimal?" InputId="@($"terms-new-fee-fixed-{wallet.Id}")" @bind-Value="wallet.NewTerms.FeeFixed"
                                             Converter="@wallet.NewTerms.FeeFixedConverter"
                                             Culture="@CultureInfo.InvariantCulture" Format="0.00##" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <div class="noof-field">
                            <label class="noof-field-label" for="@($"terms-new-fee-minimum-{wallet.Id}")">Minimum fee, @wallet.Currency</label>
                            <MudNumericField T="decimal?" InputId="@($"terms-new-fee-minimum-{wallet.Id}")" @bind-Value="wallet.NewTerms.FeeMinimum"
                                             Converter="@wallet.NewTerms.FeeMinimumConverter"
                                             Culture="@CultureInfo.InvariantCulture" Format="0.00##" HideSpinButtons="true"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>
                        <div class="noof-wallet-actions">
                            <MudButton id="@($"terms-add-{wallet.Id}")" Variant="Variant.Outlined" Size="Size.Small"
                                       OnClick="@(() => AddTermsAsync(wallet))">
                                Add terms
                            </MudButton>
                        </div>
                    </div>
                }
            </div>
        }
    </MudPaper>
}

<MudPaper Outlined="true" Elevation="0" Class="pa-5">
    <MudText HtmlTag="h2" Typo="Typo.h6" Class="mb-4">New wallet</MudText>

    @* One label convention for the whole form: a caption above each control, which is the only one
       the native currency <select> can share, so every field's bottom edge lines up in the row. *@
    <div class="noof-form-grid">
        <div class="noof-field">
            <label class="noof-field-label" for="new-wallet-name">Name</label>
            <MudTextField T="string" InputId="new-wallet-name" @bind-Value="newName"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>

        <div class="noof-field">
            <label class="noof-field-label" for="new-wallet-currency">Currency</label>
            <select id="new-wallet-currency" @bind="newCurrency" class="noof-native-select">
                @foreach (var currency in CurrencyCode.Supported)
                {
                    <option value="@currency.Value">@currency.Value</option>
                }
            </select>
        </div>

        <div class="noof-field">
            <label class="noof-field-label" for="new-wallet-opening">Opening balance</label>
            <MudNumericField T="decimal?" InputId="new-wallet-opening" @bind-Value="newOpeningBalance"
                             Converter="@newOpeningConverter"
                             Culture="@CultureInfo.InvariantCulture" HideSpinButtons="true"
                             Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>

        <div class="noof-field">
            <label class="noof-field-label" for="new-wallet-date">Opening date</label>
            <MudTextField T="DateOnly?" InputId="new-wallet-date" @bind-Value="newOpeningDate" InputType="InputType.Date"
                          Culture="@CultureInfo.InvariantCulture" Format="yyyy-MM-dd"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>

        <div class="noof-field noof-field-full">
            <label class="noof-field-label" for="new-wallet-aliases">Aliases (comma-separated)</label>
            <MudTextField T="string" InputId="new-wallet-aliases" @bind-Value="newAliases"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </div>
    </div>

    <div class="noof-wallet-row">
        <MudCheckBox T="bool" id="new-wallet-default" @bind-Value="newIsDefault"
                    Label="Default for its currency" />
        <MudSpacer />
        <MudButton id="create-wallet" Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAsync">
            Create wallet
        </MudButton>
    </div>
</MudPaper>
}

@code {
    sealed class Row
    {
        public required Guid Id { get; init; }
        public required CurrencyCode Currency { get; init; }
        public required bool IsDefaultForCurrency { get; set; }
        public required bool Archived { get; set; }
        public string PendingName { get; set; } = string.Empty;
        public string PendingAliases { get; set; } = string.Empty;
        public PaymentMethod? PendingPaymentDefault { get; set; }
        public List<TermsRow> Terms { get; set; } = [];
        public List<CurrencyCode> OfferedCurrencies { get; set; } = [];
        public TermsRow NewTerms { get; set; } = new();
    }

    // One shape for a saved row and the new row: each field's converter lives here, not in the markup, because its
    // Failed must survive re-renders until the row is saved or reloaded.
    sealed class TermsRow
    {
        public string Currency { get; set; } = string.Empty;
        public decimal? Rate { get; set; }
        public decimal? FeePercent { get; set; }
        public decimal? FeeFixed { get; set; }
        public decimal? FeeMinimum { get; set; }
        public DecimalFieldConverter RateConverter { get; } = new();
        public DecimalFieldConverter FeePercentConverter { get; } = new();
        public DecimalFieldConverter FeeFixedConverter { get; } = new();
        public DecimalFieldConverter FeeMinimumConverter { get; } = new();

        public bool Unreadable =>
            RateConverter.Failed || FeePercentConverter.Failed || FeeFixedConverter.Failed || FeeMinimumConverter.Failed;
    }

    List<Row> wallets = [];
    List<string> missingDefaultCurrencies = [];
    string? error;
    string? saved;

    string newName = string.Empty;
    string newCurrency = CurrencyCode.Rsd.Value;
    decimal? newOpeningBalance;
    readonly DecimalFieldConverter newOpeningConverter = new();
    DateOnly? newOpeningDate = DateOnly.FromDateTime(DateTime.Today);
    string newAliases = string.Empty;
    bool newIsDefault;

    readonly CancellationTokenSource cancellation = new();

    protected override async Task OnInitializedAsync()
    {
        if (Gate.State == DatabaseState.Ready)
            await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        var details = await WalletAdmin.ListAsync(cancellation.Token);
        wallets =
        [
            .. details.Select(wallet => new Row
            {
                Id = wallet.Id,
                Currency = wallet.Currency,
                IsDefaultForCurrency = wallet.IsDefaultForCurrency,
                Archived = wallet.Archived,
                PendingName = wallet.Name,
                PendingAliases = string.Join(", ", wallet.Aliases),
                PendingPaymentDefault = wallet.DefaultForPayment,
            }),
        ];

        foreach (var wallet in wallets.Where(wallet => !wallet.Archived))
            await LoadTermsAsync(wallet);

        missingDefaultCurrencies =
        [
            .. details
                .Where(wallet => !wallet.Archived)
                .GroupBy(wallet => wallet.Currency.Value)
                .Where(group => !group.Any(wallet => wallet.IsDefaultForCurrency))
                .Select(group => group.Key)
                .OrderBy(currency => currency, StringComparer.Ordinal),
        ];
    }

    async Task LoadTermsAsync(Row wallet)
    {
        var terms = await WalletFxTerms.ListAsync(wallet.Id, cancellation.Token);

        wallet.Terms =
        [
            .. terms.Select(stored => new TermsRow
            {
                Currency = stored.Currency.Value,
                Rate = stored.Rate,
                FeePercent = stored.FeePercent,
                FeeFixed = stored.FeeFixed,
                FeeMinimum = stored.FeeMinimum,
            }),
        ];
        wallet.OfferedCurrencies =
        [
            .. CurrencyCode.Supported
                .Where(currency => currency != wallet.Currency && terms.All(stored => stored.Currency != currency))
                .Order(),
        ];
        wallet.NewTerms = new TermsRow
        {
            Currency = wallet.OfferedCurrencies.Count > 0 ? wallet.OfferedCurrencies[0].Value : string.Empty,
        };
    }

    static IReadOnlyList<string> SplitAliases(string raw) =>
        [.. raw.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)];

    async Task CreateAsync()
    {
        error = null;
        saved = null;

        var name = newName.Trim();
        if (name.Length == 0)
        {
            error = "Enter a wallet name.";
            return;
        }

        if (newOpeningDate is not { } openingDate)
        {
            error = "Enter an opening date.";
            return;
        }

        if (newOpeningConverter.Failed)
        {
            error = "The opening balance is not a number.";
            return;
        }

        try
        {
            await WalletAdmin.CreateAsync(
                new NewWallet(name, new CurrencyCode(newCurrency), newOpeningBalance ?? 0m, openingDate,
                    SplitAliases(newAliases), newIsDefault),
                cancellation.Token);

            newName = string.Empty;
            newOpeningBalance = 0m;
            newAliases = string.Empty;
            newIsDefault = false;
            saved = $"Created {name}.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            error = $"Could not create the wallet: {exception.Message}";
        }
    }

    async Task RenameAsync(Row wallet)
    {
        error = null;
        saved = null;

        var name = wallet.PendingName.Trim();
        if (name.Length == 0)
        {
            error = "Enter a wallet name.";
            return;
        }

        try
        {
            await WalletAdmin.RenameAsync(wallet.Id, name, cancellation.Token);
            saved = "Renamed.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            error = $"Could not rename the wallet: {exception.Message}";
        }
    }

    async Task SaveAliasesAsync(Row wallet)
    {
        error = null;
        saved = null;

        try
        {
            await WalletAdmin.SetAliasesAsync(wallet.Id, SplitAliases(wallet.PendingAliases), cancellation.Token);
            saved = "Aliases saved.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            error = $"Could not save the aliases: {exception.Message}";
        }
    }

    async Task MakeDefaultAsync(Row wallet)
    {
        error = null;
        saved = null;

        try
        {
            await WalletAdmin.MakeDefaultForCurrencyAsync(wallet.Id, cancellation.Token);
            saved = "Made default.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            error = $"Could not make it the default: {exception.Message}";
        }
    }

    async Task SetPaymentDefaultAsync(Row wallet)
    {
        error = null;
        saved = null;

        try
        {
            await WalletAdmin.SetPaymentDefaultAsync(wallet.Id, wallet.PendingPaymentDefault, cancellation.Token);
            saved = "Payment default saved.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            error = $"Could not save the payment default: {exception.Message}";
        }
    }

    async Task ArchiveAsync(Row wallet)
    {
        error = null;
        saved = null;

        try
        {
            await WalletAdmin.ArchiveAsync(wallet.Id, cancellation.Token);
            saved = "Archived.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            error = $"Could not archive the wallet: {exception.Message}";
        }
    }

    async Task AddTermsAsync(Row wallet)
    {
        error = null;
        saved = null;

        var terms = wallet.NewTerms;
        if (TermsFrom(terms, out var problem) is not { } details)
        {
            error = problem;
            return;
        }

        try
        {
            await WalletFxTerms.SetAsync(wallet.Id, details, cancellation.Token);
            saved = $"{terms.Currency} terms added.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            error = $"Could not add the {terms.Currency} terms: {exception.Message}";
        }
    }

    async Task SaveTermsAsync(Row wallet, TermsRow terms)
    {
        error = null;
        saved = null;

        if (TermsFrom(terms, out var problem) is not { } details)
        {
            error = problem;
            return;
        }

        try
        {
            await WalletFxTerms.SetAsync(wallet.Id, details, cancellation.Token);
            saved = $"{terms.Currency} terms saved.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            error = $"Could not save the {terms.Currency} terms: {exception.Message}";
        }
    }

    async Task RemoveTermsAsync(Row wallet, TermsRow terms)
    {
        error = null;
        saved = null;

        try
        {
            await WalletFxTerms.RemoveAsync(wallet.Id, new CurrencyCode(terms.Currency), cancellation.Token);
            saved = $"{terms.Currency} terms removed.";
            await ReloadAsync();
        }
        catch (Exception exception)
        {
            error = $"Could not remove the {terms.Currency} terms: {exception.Message}";
        }
    }

    // The page checks before it calls, as it does for a blank wallet name: the store's own refusals are bug guards. An
    // unreadable field has already been turned into null by MudBlazor, so it is refused before its value is looked at -
    // and once it loses focus MudBlazor empties it but keeps its error, so the alert says how to get out of that.
    static WalletTermsDetails? TermsFrom(TermsRow terms, out string problem)
    {
        problem = string.Empty;

        if (terms.Unreadable)
        {
            problem = $"The {terms.Currency} terms have a field that is not a number. "
                + "Type the figure again in the field marked in red.";
            return null;
        }

        if (terms.Rate is not { } rate || rate <= 0m)
        {
            problem = $"Enter a rate above zero for {terms.Currency}.";
            return null;
        }

        if (terms.FeePercent < 0m || terms.FeeFixed < 0m || terms.FeeMinimum < 0m)
        {
            problem = $"A {terms.Currency} fee cannot be negative.";
            return null;
        }

        return new WalletTermsDetails(new CurrencyCode(terms.Currency), rate, terms.FeePercent, terms.FeeFixed, terms.FeeMinimum);
    }

    public void Dispose()
    {
        cancellation.Cancel();
        cancellation.Dispose();
    }
}

@page "/diagnostics"
@attribute [Authorize]
@using Noof.Ledger.Application.Diagnostics
@using Noof.Ledger.Application.Diagnostics.BugReports
@using Noof.Ledger.Application.Diagnostics.Integrity
@inject ISystemHealth SystemHealth
@inject IBugReportStore BugReports
@inject IDatabaseGate Gate

<PageTitle>Diagnostics</PageTitle>

<MudText HtmlTag="h1" Typo="Typo.h4" Class="mb-6">Diagnostics</MudText>

@if (Gate.State != DatabaseState.Ready)
{
    <DatabaseGateBanner />
}
else
{
    <MudSimpleTable id="diagnostics-checks" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="mb-6">
        <thead>
            <tr>
                <th>Check</th>
                <th>Level</th>
                <th>Summary</th>
                <th class="noof-hide-narrow">Checked at</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (report is not null)
            {
                @foreach (var item in report.Items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@LevelColor(item.Level)">@item.Level</MudChip>
                        </td>
                        <td>@item.Summary</td>
                        <td class="noof-hide-narrow noof-nowrap">@item.CheckedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>
                            @if (item.Name == IntegrityHealth.CheckName)
                            {
                                <MudLink id="diagnostics-integrity-link" Href="@IntegrityHealth.PagePath" Class="mr-3">Findings</MudLink>
                                <MudLink id="diagnostics-bug-reports-link" Href="/bugs" Class="mr-3">@OpenReportsText(openReports)</MudLink>
                            }
                            @if (item.Level != HealthLevel.Ok)
                            {
                                <MudLink Href="@($"/diagnostics/logs?source={Uri.EscapeDataString(item.LogCategory)}")">Logs</MudLink>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </MudSimpleTable>

    <MudLink id="diagnostics-view-all-logs" Href="/diagnostics/logs">View all logs &rarr;</MudLink>
}

@code {
    SystemHealthReport? report;
    int? openReports;

    static Color LevelColor(HealthLevel level) => level switch
    {
        HealthLevel.Ok => Color.Success,
        HealthLevel.Warning => Color.Warning,
        HealthLevel.Failing => Color.Error,
        _ => Color.Default,
    };

    static string OpenReportsText(int? count) => count switch
    {
        null => "Bug reports",
        0 => "No open reports",
        1 => "1 open report",
        _ => $"{count} open reports",
    };

    protected override async Task OnInitializedAsync()
    {
        if (Gate.State != DatabaseState.Ready)
            return;

        report = await SystemHealth.GetAsync(fresh: true, CancellationToken.None);
        openReports = await CountOpenReportsAsync();
    }

    // The operator opens this page when something is failing; the one query it adds must not turn it into an error page.
    async Task<int?> CountOpenReportsAsync()
    {
        try
        {
            return await BugReports.CountOpenAsync(CancellationToken.None);
        }
        catch (Exception)
        {
            return null;
        }
    }
}
